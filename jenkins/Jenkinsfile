// ─────────────────────────────────────────────────────────────────────────────
// Mealie — CI/CD Pipeline (Infrastructure + Application)
//
// Triggered on every push to the configured branch. On the first run it
// creates all AWS infrastructure; on subsequent runs Terraform is a no-op and
// only the application image is updated.
//
// Flow:
//   1. Configure AWS & derive resource names
//   2. Bootstrap Terraform state backend (idempotent S3 bucket creation)
//   3. Create ECR repository  (terraform apply -target=module.ecr)
//   4. Terraform plan (console output) + manual approval gate
//   5. Build Docker image from source
//   6. Push image to ECR
//   7. Apply the approved plan  (terraform apply tfplan)
//   8. Register new ECS task definition revision with the exact image tag
//   9. Update ECS service and wait for stability
//
// One-time Jenkins setup:
//   • Add AWS credentials (Kind: "AWS Credentials") with ID "aws-mealie-creds"
//     - Retrieve the keys after first infra apply:
//       aws secretsmanager get-secret-value \
//         --secret-id mealie-prod-jenkins-credentials --region us-east-1
//     - For the very first run, use any IAM user/role with broad AWS permissions
//       (the pipeline will create the dedicated mealie-jenkins IAM user for
//        subsequent runs).
//   • Install on the Jenkins agent: Docker, AWS CLI v2, Terraform >= 1.5, jq
//   • Configure a GitHub webhook → Jenkins (use "GitHub hook trigger for
//     GITScm polling" in the pipeline job's Build Triggers)
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Override image tag. Defaults to build-<BUILD_NUMBER>.'
        )
        string(
            name: 'DEPLOY_BRANCH',
            defaultValue: 'mealie-next',
            description: 'Branch that triggers a full infra + deploy run.'
        )
    }

    environment {
        // ── Adjust these to match your terraform.tfvars ───────────────────────
        AWS_REGION     = 'us-east-1'
        PROJECT_NAME   = 'mealie'
        ENVIRONMENT    = 'prod'
        // Derived names (pattern: <project>-<env>, must match Terraform outputs)
        ECR_REPO_NAME  = 'mealie'
        ECS_CLUSTER    = 'mealie-prod'
        ECS_SERVICE    = 'mealie-prod'
        TF_FAMILY      = 'mealie-prod'
        TF_DIR         = 'terraform'
        // Used as a -var flag (highest precedence, overrides terraform.tfvars)
        ALLOWED_CIDR_BLOCKS = '["0.0.0.0/0"]'
        // ─────────────────────────────────────────────────────────────────────
    }

    stages {

        // ── 1. Resolve tag ────────────────────────────────────────────────────
        stage('Resolve Image Tag') {
            steps {
                script {
                    env.TAG = params.IMAGE_TAG?.trim() ?: "build-${env.BUILD_NUMBER}"
                    echo "Image tag: ${env.TAG}"
                }
            }
        }

        // ── 2. AWS identity + derived names ───────────────────────────────────
        stage('Configure AWS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        // Deterministic bucket name: same formula used in bootstrap/main.tf
                        env.TF_STATE_BUCKET = "${PROJECT_NAME}-tfstate-${env.AWS_ACCOUNT_ID}"
                        env.ECR_REGISTRY    = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        env.FULL_IMAGE      = "${env.ECR_REGISTRY}/${ECR_REPO_NAME}"
                    }
                }
            }
        }

        // ── 3. Bootstrap Terraform state backend (idempotent) ─────────────────
        stage('Bootstrap State Backend') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        set -e

                        # ── S3 bucket ──────────────────────────────────────────
                        if aws s3api head-bucket --bucket ${env.TF_STATE_BUCKET} \
                               --region ${AWS_REGION} 2>/dev/null; then
                            echo "State bucket already exists: ${env.TF_STATE_BUCKET}"
                        else
                            echo "Creating state bucket: ${env.TF_STATE_BUCKET}"
                            if [ "${AWS_REGION}" = "us-east-1" ]; then
                                aws s3api create-bucket \
                                    --bucket ${env.TF_STATE_BUCKET} \
                                    --region ${AWS_REGION}
                            else
                                aws s3api create-bucket \
                                    --bucket ${env.TF_STATE_BUCKET} \
                                    --region ${AWS_REGION} \
                                    --create-bucket-configuration LocationConstraint=${AWS_REGION}
                            fi
                            aws s3api put-bucket-versioning \
                                --bucket ${env.TF_STATE_BUCKET} \
                                --versioning-configuration Status=Enabled
                            aws s3api put-bucket-encryption \
                                --bucket ${env.TF_STATE_BUCKET} \
                                --server-side-encryption-configuration \
                                '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
                            aws s3api put-public-access-block \
                                --bucket ${env.TF_STATE_BUCKET} \
                                --public-access-block-configuration \
                                "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true"
                        fi
                    """
                }
            }
        }

        // ── 4. Terraform init ─────────────────────────────────────────────────
        stage('Terraform Init') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.TF_DIR) {
                        sh """
                            terraform init \
                                -backend-config="bucket=${env.TF_STATE_BUCKET}" \
                                -backend-config="key=mealie/terraform.tfstate" \
                                -backend-config="region=${AWS_REGION}" \
                                -backend-config="use_lockfile=true" \
                                -backend-config="encrypt=true" \
                                -reconfigure
                        """
                    }
                }
            }
        }

        // ── 5. Create ECR first so we have a registry to push to ──────────────
        stage('Create ECR Repository') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.TF_DIR) {
                        sh """
                            terraform apply \
                                -target=module.ecr \
                                -auto-approve
                        """
                    }
                }
            }
        }

        // ── 5b. Terraform plan: show what will be created/updated/destroyed ──
        // Runs after ECR exists so the plan reflects the real remaining diff.
        // The plan is saved to a file so Apply executes exactly what is reviewed.
        stage('Terraform Plan') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.TF_DIR) {
                        script {
                            // -detailed-exitcode: 0 = no changes, 2 = changes, 1 = error
                            def rc = sh(
                                script: """
                                    terraform plan \
                                        -input=false \
                                        -no-color \
                                        -detailed-exitcode \
                                        -var='allowed_cidr_blocks=${env.ALLOWED_CIDR_BLOCKS}' \
                                        -out=tfplan
                                """,
                                returnStatus: true
                            )
                            if (rc == 1) {
                                error('terraform plan failed')
                            }
                            env.TF_HAS_CHANGES = (rc == 2) ? 'true' : 'false'
                            echo env.TF_HAS_CHANGES == 'true'
                                ? 'Terraform detected changes. Review the plan above.'
                                : 'No infrastructure changes detected.'
                        }
                    }
                }
            }
        }

        // ── 5c. Manual confirmation (skipped when there is nothing to change) ─
        stage('Approve Plan') {
            when { expression { env.TF_HAS_CHANGES == 'true' } }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input(
                        message: 'Review the Terraform plan in the console output above. Apply these changes?',
                        ok: 'Apply'
                    )
                }
            }
        }

        // ── 6. Build Docker image ─────────────────────────────────────────────
        stage('Build Docker Image') {
            steps {
                sh """
                    docker build \
                        --build-arg COMMIT=${env.GIT_COMMIT ?: 'unknown'} \
                        -t ${env.FULL_IMAGE}:${env.TAG} \
                        -t ${env.FULL_IMAGE}:latest \
                        -f docker/Dockerfile .
                """
            }
        }

        // ── 7. Push image to ECR ──────────────────────────────────────────────
        stage('Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin ${env.ECR_REGISTRY}
                    """
                    // Large layer uploads can be reset by flaky networks (e.g. VM NAT).
                    // Already-pushed layers are skipped on retry, so this is cheap.
                    retry(5) {
                        sh """
                            docker push ${env.FULL_IMAGE}:${env.TAG}
                            docker push ${env.FULL_IMAGE}:latest
                        """
                    }
                }
            }
        }

        // ── 8. Apply full infrastructure ──────────────────────────────────────
        // ECR already exists; this creates VPC, RDS, EFS, ALB, ECS, IAM, etc.
        // Idempotent: safe to run on every push.
        stage('Apply Infrastructure') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.TF_DIR) {
                        sh """
                            terraform apply -input=false tfplan
                        """
                    }
                }
            }
        }

        // ── 9. Deploy new image to ECS ────────────────────────────────────────
        // Registers a new task definition revision with the exact build tag and
        // forces a rolling update of the ECS service.
        stage('Deploy to ECS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        set -e

                        TASK_DEF_JSON=\$(aws ecs describe-task-definition \
                            --task-definition ${TF_FAMILY} \
                            --region ${AWS_REGION} \
                            --query taskDefinition \
                            --output json)

                        NEW_TASK_DEF=\$(echo "\$TASK_DEF_JSON" | jq \
                            --arg IMAGE "${env.FULL_IMAGE}:${env.TAG}" \
                            '.containerDefinitions[0].image = \$IMAGE
                             | del(.taskDefinitionArn, .revision, .status,
                                   .requiresAttributes, .compatibilities,
                                   .registeredAt, .registeredBy)')

                        NEW_REVISION=\$(aws ecs register-task-definition \
                            --region ${AWS_REGION} \
                            --cli-input-json "\$NEW_TASK_DEF" \
                            --query 'taskDefinition.taskDefinitionArn' \
                            --output text)

                        echo "Registered: \$NEW_REVISION"

                        aws ecs update-service \
                            --cluster ${ECS_CLUSTER} \
                            --service ${ECS_SERVICE} \
                            --task-definition "\$NEW_REVISION" \
                            --region ${AWS_REGION}
                    """
                }
            }
        }

        // ── 10. Wait for stable deployment ────────────────────────────────────
        stage('Wait for Stability') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-mealie-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    timeout(time: 15, unit: 'MINUTES') {
                        sh """
                            aws ecs wait services-stable \
                                --cluster ${ECS_CLUSTER} \
                                --services ${ECS_SERVICE} \
                                --region ${AWS_REGION}
                            echo "Deployment complete."

                            ALB_DNS=\$(aws elbv2 describe-load-balancers \
                                --names ${PROJECT_NAME}-${ENVIRONMENT}-alb \
                                --region ${AWS_REGION} \
                                --query 'LoadBalancers[0].DNSName' \
                                --output text)
                            echo "Mealie is available at: http://\$ALB_DNS"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'rm -f ${TF_DIR}/tfplan || true'
            sh 'docker image prune -f || true'
        }
        success {
            echo "Pipeline succeeded. Deployed ${env.FULL_IMAGE}:${env.TAG}"
        }
        failure {
            echo "Pipeline failed. Check logs above. Infrastructure may be partially created."
        }
    }
}
