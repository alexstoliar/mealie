# Copy this file to terraform.tfvars (it is gitignored) and adjust as needed.

project_name = "mealie"
environment  = "prod"
aws_region   = "us-east-1"

# ── Networking ────────────────────────────────────────────────────────────────
# Use the existing corporate VPC. Subnets must span at least 2 AZs (required by ALB and RDS).
existing_vpc_id     = "vpc-03a6c93961c48f3e6"
existing_subnet_ids = ["subnet-0946c05e288097986", "subnet-078a376937569f346"]

# Corporate VPN and office IP ranges allowed to reach the ALB (port 80).
# Source: SecureVPC CloudFormation stack security group egress rules.
allowed_cidr_blocks = [
  "195.160.232.0/22",
  "185.112.172.0/22",
  "217.9.4.0/22",
  "172.16.0.0/16",
  "10.104.132.0/22",
]

# ── RDS PostgreSQL ────────────────────────────────────────────────────────────
# db.t3.micro ~$15/month (20 GB storage included in free tier for 12 months)
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20

# ── ECS Fargate ───────────────────────────────────────────────────────────────
# 512 CPU + 1024 MB memory ~$18/month
ecs_task_cpu      = 512
ecs_task_memory   = 1024
ecs_desired_count = 1

# ── Application ───────────────────────────────────────────────────────────────
allow_signup     = "false"
mealie_image_tag = "latest"
